# ===================================================
# SignalBridge AI — Server Environment Configuration
# ===================================================

# Server port (default: 3001)
PORT=3001

# Google Gemini API Key
# Obtain a key from Google AI Studio: https://aistudio.google.com/
# Leave blank to test with local diagnostic heuristic fallback mode
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model to use (default: gemini-2.5-flash)
# Supported models include: gemini-2.5-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# CORS Allowed Origin (default: http://localhost:5173 for Vite)
CORS_ORIGIN=http://localhost:5173
